# FreeCoder 应用运行时配置
# 复制此文件为 .env 并填入实际值

# ========== JWT 配置 ==========
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7

# ========== OAuth: GitHub ==========
# 在 https://github.com/settings/developers 创建 OAuth App
# Authorization callback URL: http://localhost:3000/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========== OAuth: Google ==========
# 在 https://console.cloud.google.com/apis/credentials 创建 OAuth 2.0 客户端
# 授权重定向 URI: http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========== OAuth: 微信 ==========
# 在 https://open.weixin.qq.com 创建网站应用（需已认证）
# 授权回调域: localhost
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ========== 其他 ==========
# OAuth 回调基础 URL（不含尾部斜杠）
OAUTH_REDIRECT_BASE=http://localhost:3000
# 服务端口
PORT=80
